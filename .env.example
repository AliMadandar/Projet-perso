# Node 24. Copier dans .env pour personnaliser.
HOST=127.0.0.1
PORT=3000
DB_PATH=data/atelier.sqlite
ADMIN_LOGIN=admin
# Premier démarrage uniquement. Vide en local = mot de passe généré dans le terminal.
ADMIN_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Sur serveur : NODE_ENV=production et origine publique HTTPS exacte (sans / final).
APP_ORIGIN=
# Facultatif : notifications vers votre sujet privé ntfy, même application fermée.
NTFY_URL=
NTFY_TOKEN=
# Nom de domaine utilisé uniquement par Docker Compose.
DOMAIN=

# Envoi Gmail facultatif. Identifiants OAuth du compte expéditeur.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Chemin complet de Chrome ou Edge si sa détection automatique échoue.
PDF_BROWSER=
